{
  "name": "@dsh/files",
  "version": "0.2.0",
  "description": "File manager page and native file tools for DeepSeek Harness, with shared APIs for zcode, MCP and other agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wcof/dsh-files.git"
  },
  "homepage": "https://github.com/Wcof/dsh-files#readme",
  "engines": {
    "node": ">=20.11.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "main": "./src/index.js",
  "types": "./src/protocol/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/protocol/types.d.ts",
      "default": "./src/index.js"
    },
    "./config": "./src/config.js",
    "./dsh": "./src/dsh-plugin.js",
    "./client": "./client.js",
    "./icon": "./web/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./protocol": "./src/protocol/commands.js",
    "./adapters": "./src/adapters/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-files": "./bin/cli.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "docs/",
    "client.js",
    "web/",
    "locale/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "npm test && node scripts/check-contract.mjs",
    "check:dsh-runtime": "node scripts/check-dsh-runtime.mjs",
    "tools": "node bin/cli.mjs list-tools",
    "describe": "node bin/cli.mjs describe",
    "stdio": "node bin/cli.mjs stdio",
    "mcp": "node bin/cli.mjs mcp",
    "http": "node bin/cli.mjs http"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  },
  "dependencies": {}
}
